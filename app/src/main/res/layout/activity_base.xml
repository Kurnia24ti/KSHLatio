<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- Konten utama: container fragment + bottom navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <FrameLayout android:id="@+id/fragment_container"
            android:layout_width="match_parent" android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/bottom_nav_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav_view"
            style="@style/Widget.MaterialComponents.BottomNavigationView"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/white" android:elevation="8dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bilah aplikasi (drawer) -->
    <LinearLayout android:id="@+id/drawerPanel"
        android:layout_width="300dp" android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer_panel"
        android:clickable="true" android:focusable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp" android:paddingTop="48dp" android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">

            <ImageView android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/bg_logo_square" android:padding="9dp"
                android:src="@drawable/ic_eco" app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/brand_name" android:textColor="@color/primary_dark"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/drawer_portal" android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView android:id="@+id/ivCloseDrawer"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/bg_circle_mint" android:padding="11dp"
                android:src="@drawable/ic_close" app:tint="@color/primary_dark"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="16dp" android:background="@color/stroke" />

        <!-- Menu -->
        <TextView android:id="@+id/tvMenuDashboard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_menu_active"
            android:drawableStart="@drawable/ic_dashboard" android:drawableTint="@color/primary"
            android:drawablePadding="14dp" android:padding="14dp"
            android:text="@string/nav_dashboard"
            android:textColor="@color/primary" android:textSize="14sp" android:textStyle="bold" />

        <TextView android:id="@+id/tvMenuKebun"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_eco" android:drawableTint="@color/text_gray"
            android:drawablePadding="14dp" android:padding="14dp"
            android:text="@string/drawer_data_kebun"
            android:textColor="@color/text_dark" android:textSize="14sp" />

        <TextView android:id="@+id/tvMenuRiwayat"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_history" android:drawableTint="@color/text_gray"
            android:drawablePadding="14dp" android:padding="14dp"
            android:text="@string/drawer_riwayat"
            android:textColor="@color/text_dark" android:textSize="14sp" />

        <TextView android:id="@+id/tvMenuProfil"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_person" android:drawableTint="@color/text_gray"
            android:drawablePadding="14dp" android:padding="14dp"
            android:text="@string/drawer_profil"
            android:textColor="@color/text_dark" android:textSize="14sp" />

        <!-- Logout -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnLogoutDrawer"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="@string/drawer_logout" android:textAllCaps="false" android:textStyle="bold"
            android:backgroundTint="@color/danger"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_logout" app:iconGravity="textStart" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>