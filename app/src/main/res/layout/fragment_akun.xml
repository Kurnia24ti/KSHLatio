<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_app">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/primary_dark"
            app:layout_scrollFlags="scroll|enterAlways" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">

            <TextView android:id="@+id/tvAvatar"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_circle_primary"
                android:gravity="center" android:textColor="@color/white"
                android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvNama"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/primary_dark" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvEmail"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_gray" android:textSize="12sp" />
            <TextView android:id="@+id/tvRole"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_badge"
                android:paddingHorizontal="16dp" android:paddingVertical="5dp"
                android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />

            <!-- FITUR 3: Dark Mode / Light Mode Switch Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_show_chart"
                        app:tint="@color/primary"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mode Gelap (Dark Mode)"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDarkModeDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ubah tema aplikasi ke Mode Gelap 🌙"
                            android:textColor="@color/text_gray"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDarkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton android:id="@+id/btnBantuan"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/akun_help" android:textAllCaps="false" android:textStyle="bold"
                android:backgroundTint="@color/primary" app:cornerRadius="26dp"
                app:icon="@drawable/ic_arrow_forward" app:iconGravity="textEnd" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnTentang"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/akun_about" android:textAllCaps="false"
                android:textColor="@color/text_dark"
                app:cornerRadius="26dp" app:strokeColor="@color/stroke" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/drawer_logout" android:textAllCaps="false" android:textStyle="bold"
                android:backgroundTint="@color/danger" app:cornerRadius="26dp"
                app:icon="@drawable/ic_logout" app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>