<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_app">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/white" app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@color/primary_dark"
            app:layout_scrollFlags="scroll|enterAlways" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">

            <TextView android:id="@+id/tvAvatar"
                android:layout_width="88dp" android:layout_height="88dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_circle_primary"
                android:gravity="center" android:textColor="@color/white"
                android:textSize="28sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvNama"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/primary_dark" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvEmail"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_gray" android:textSize="12sp" />
            <TextView android:id="@+id/tvRole"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:background="@drawable/bg_badge"
                android:paddingHorizontal="16dp" android:paddingVertical="5dp"
                android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnBantuan"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:text="@string/akun_help" android:textAllCaps="false" android:textStyle="bold"
                android:backgroundTint="@color/primary" app:cornerRadius="26dp"
                app:icon="@drawable/ic_arrow_forward" app:iconGravity="textEnd" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnTentang"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/akun_about" android:textAllCaps="false"
                android:textColor="@color/text_dark"
                app:cornerRadius="26dp" app:strokeColor="@color/stroke" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/drawer_logout" android:textAllCaps="false" android:textStyle="bold"
                android:backgroundTint="@color/danger" app:cornerRadius="26dp"
                app:icon="@drawable/ic_logout" app:iconGravity="textStart" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>