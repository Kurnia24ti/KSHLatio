<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:layout_scrollFlags="scroll|enterAlways"
            app:title="Activity Fifth"
            app:subtitle="Ini adalah subtitle"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:text="Halaman ini mendemonstrasikan CoordinatorLayout + AppBarLayout dengan Toolbar yang menyembunyikan diri saat digulir (scroll|enterAlways). Di bawah ini terdapat tombol untuk membuka WebView." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWebView"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Buka WebView"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary"
                app:cornerRadius="26dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/text_gray"
                android:textSize="14sp"
                android:text="Teks panjang tambahan untuk memperluas konten sehingga halaman ini bisa di-scroll...\n\nKonten 1: Penjelasan CoordinatorLayout.\n\nKonten 2: Penjelasan AppBarLayout.\n\nKonten 3: Penjelasan NestedScrollView.\n\nKonten 4: Integrasi WebView dengan Toolbar scroll behavior." />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>