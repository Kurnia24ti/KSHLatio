<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.KSHLatio">

        <!-- Splash Screen sebagai LAUNCHER utama -->
        <activity
            android:name="com.example.KSHLatio.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.KSHLatio.BaseActivity"
            android:exported="true" />

        <activity
            android:name="com.example.KSHLatio.DetailActivity"
            android:exported="true" />

        <activity
            android:name="com.example.KSHLatio.ProfileActivity"
            android:exported="true" />

        <activity
            android:name="com.example.KSHLatio.LoginActivity"
            android:exported="true" />

        <activity
            android:name="com.example.KSHLatio.GmailInputActivity"
            android:exported="false" />

        <activity
            android:name="com.example.KSHLatio.RegisterActivity"
            android:exported="false" />

        <activity
            android:name="com.example.KSHLatio.RegisterSuccessActivity"
            android:exported="false" />

        <activity
            android:name="com.example.KSHLatio.WebActivity"
            android:exported="true" />

        <activity
            android:name="com.example.KSHLatio.LandingActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.example.KSHLatio.MainActivity"
            android:exported="true" />

        <activity
            android:name="com.example.KSHLatio.DetailSnackActivity"
            android:exported="true"
            android:parentActivityName="com.example.KSHLatio.MainActivity" />

    </application>

</manifest>